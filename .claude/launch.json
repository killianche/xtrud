{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "xtrud-web",
      "runtimeExecutable": "sh",
      "runtimeArgs": ["-c", "BROWSER=none npx expo start --web --port 8082 --clear"],
      "port": 8082
    },
    {
      "name": "xtrud-web-prod",
      "runtimeExecutable": "sh",
      "runtimeArgs": ["-c", "npx serve dist -p 8082 -s"],
      "port": 8082
    }
  ]
}
