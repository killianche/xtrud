# Текущий source of truth до санкционированного Beget cutover — Supabase Cloud.
# Целевой api.xtrud.pro настраивается только по infra/supabase/.env.example и
# docs/SUPABASE_BEGET_MIGRATION.md; обычный local setup не должен идти туда раньше времени.
EXPO_PUBLIC_SUPABASE_URL=https://wgeimsajvjkzrrnfrnkb.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=<current-cloud-publishable-or-anon-key>

# Demo-flow (dev only). В production ВСЕГДА false / не выставлять.
# true → разрешён вход по demo phone +79000xxxxxxx с паролем "xtrud".
# Если =true в production submit → security hole (любой может войти под demo).
EXPO_PUBLIC_ENABLE_DEMO=false

# Скрывает demo-аккаунты в каталоге / top-masters / orders-feed.
# В production = "false" (по умолчанию демо видны).
EXPO_PUBLIC_DEMO_MODE=true

# Отслеживание сбоев (Sentry). НЕОБЯЗАТЕЛЬНО.
# Если пусто / не задано — Sentry выключен, на работу приложения это не влияет.
# Чтобы включить: создать бесплатный проект на sentry.io → скопировать DSN сюда
# (локально в .env.local) и в EAS/CI secrets (для сборок приложения).
EXPO_PUBLIC_SENTRY_DSN=
