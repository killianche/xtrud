# Переменные приложения (Expo). Скопируйте в .env.local для локального запуска.
# Секретов здесь нет: EXPO_PUBLIC_* встраиваются в сборку и видны всем.
# Значения для сборок в App Store задаёт eas.json.

# Адрес своего сервера xtrud-api (docs/BACKEND_REWRITE_PLAN.md).
EXPO_PUBLIC_API_URL=https://api.xtrud.pro

# Sentry выключен (DECISION владельца 2026-08-30): пусто — отправки нет.
EXPO_PUBLIC_SENTRY_DSN=

# Демо-данные на экранах (src/lib/demo-mode.ts). В сборках — false.
EXPO_PUBLIC_DEMO_MODE=false
# Тестовый вход по демо-номерам (src/lib/auth.ts). В сборках — пусто.
EXPO_PUBLIC_ENABLE_DEMO=
