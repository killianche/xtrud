EXPO_PUBLIC_SUPABASE_URL=https://<your-project-ref>.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx

# Demo-flow (dev only). В production ВСЕГДА false / не выставлять.
# true → разрешён вход по demo phone +79000xxxxxxx с паролем "xtrud".
# Если =true в production submit → security hole (любой может войти под demo).
EXPO_PUBLIC_ENABLE_DEMO=false

# Скрывает demo-аккаунты в каталоге / top-masters / orders-feed.
# В production = "false" (по умолчанию демо видны).
EXPO_PUBLIC_DEMO_MODE=true
