# xtrud values contract for the exact upstream snapshot in .supabase-version.
# Names are checked against upstream-v0.8.0.env.names. This is not a runnable
# secret file: copy the exact upstream .env.example on target, then apply these
# reviewed values and generate every placeholder with upstream utilities.

COMPOSE_FILE=docker-compose.yml

# Secrets — never reuse Cloud values and never commit generated values.
POSTGRES_PASSWORD=<generate-with-upstream-utilities>
JWT_SECRET=<generate-with-upstream-utilities>
ANON_KEY=<derive-with-upstream-utilities>
SERVICE_ROLE_KEY=<derive-with-upstream-utilities>
SUPABASE_PUBLISHABLE_KEY=<generate-with-upstream-utilities>
SUPABASE_SECRET_KEY=<generate-with-upstream-utilities>
JWT_KEYS=<generate-with-upstream-utilities>
JWT_JWKS=<generate-with-upstream-utilities>
DASHBOARD_USERNAME=<generate-admin-username>
DASHBOARD_PASSWORD=<generate-strong-secret>
SECRET_KEY_BASE=<generate-with-upstream-utilities>
REALTIME_DB_ENC_KEY=<generate-exactly-16-characters>
VAULT_ENC_KEY=<generate-exactly-32-characters>
PG_META_CRYPTO_KEY=<generate-at-least-32-characters>
LOGFLARE_PUBLIC_ACCESS_TOKEN=<generate-at-least-32-characters>
LOGFLARE_PRIVATE_ACCESS_TOKEN=<generate-at-least-32-characters>
S3_PROTOCOL_ACCESS_KEY_ID=<generate-with-upstream-utilities>
S3_PROTOCOL_ACCESS_KEY_SECRET=<generate-with-upstream-utilities>
ANON_KEY_ASYMMETRIC=<derive-with-upstream-utilities>
SERVICE_ROLE_KEY_ASYMMETRIC=<derive-with-upstream-utilities>

# Public URLs. API_EXTERNAL_URL is the full Auth URL, not the API origin.
SUPABASE_PUBLIC_URL=https://api.xtrud.pro
API_EXTERNAL_URL=https://api.xtrud.pro/auth/v1
SITE_URL=https://xtrud.pro
ADDITIONAL_REDIRECT_URLS=https://xtrud.pro/reset-password,xtrud://reset-password
PROXY_DOMAIN=api.xtrud.pro
CERTBOT_EMAIL=<operator-email>

# Database and Supavisor.
POSTGRES_HOST=db
POSTGRES_DB=postgres
POSTGRES_PORT=5432
POOLER_PROXY_PORT_TRANSACTION=6543
POOLER_DEFAULT_POOL_SIZE=20
POOLER_MAX_CLIENT_CONN=100
POOLER_TENANT_ID=xtrud-production
POOLER_DB_POOL_SIZE=5

# Studio. Studio remains private even though its required settings are present.
STUDIO_DEFAULT_ORGANIZATION=xtrud
STUDIO_DEFAULT_PROJECT=xtrud-production
OPENAI_API_KEY=

# Auth. Phone/password login is implemented by project RPC; Supabase SMS signup
# remains disabled unless a separately reviewed product decision enables it.
JWT_EXPIRY=3600
DISABLE_SIGNUP=false
MAILER_URLPATHS_CONFIRMATION=/auth/v1/verify
MAILER_URLPATHS_INVITE=/auth/v1/verify
MAILER_URLPATHS_RECOVERY=/auth/v1/verify
MAILER_URLPATHS_EMAIL_CHANGE=/auth/v1/verify
ENABLE_EMAIL_SIGNUP=true
ENABLE_EMAIL_AUTOCONFIRM=false
ENABLE_ANONYMOUS_USERS=<true-only-if-approved-jit-flow-remains>
ENABLE_PHONE_SIGNUP=false
ENABLE_PHONE_AUTOCONFIRM=false
SMTP_ADMIN_EMAIL=<operator-email>
SMTP_HOST=<smtp-host>
SMTP_PORT=587
SMTP_USER=<smtp-user>
SMTP_PASS=<smtp-secret>
SMTP_SENDER_NAME=xtrud

# Storage base contract. Beget external-S3 endpoint/credentials are deliberately
# absent: the base compose does not consume them. Add them only with a reviewed
# overlay whose `docker compose config` proves how every variable is wired.
GLOBAL_S3_BUCKET=<xtrud-storage-bucket>
REGION=<beget-region>
MINIO_ROOT_USER=<unused-by-external-s3-overlay>
MINIO_ROOT_PASSWORD=<unused-by-external-s3-overlay>
STORAGE_TENANT_ID=xtrud-production

# Functions/API.
FUNCTIONS_VERIFY_JWT=<set-after-per-function-auth-audit>
PGRST_DB_SCHEMAS=public,storage,graphql_public
PGRST_DB_MAX_ROWS=1000
PGRST_DB_EXTRA_SEARCH_PATH=public,extensions

# Logs and gateway. The host side of Envoy is loopback-only. The exact upstream
# compose renders API_GW_HTTP_PORT before `:8000`, producing 127.0.0.1:8000:8000.
DOCKER_SOCKET_LOCATION=/var/run/docker.sock
GOOGLE_PROJECT_ID=
GOOGLE_PROJECT_NUMBER=
API_GW_HTTP_PORT=127.0.0.1:8000
KONG_HTTP_PORT=8000
KONG_HTTPS_PORT=8443
IMGPROXY_AUTO_WEBP=true
