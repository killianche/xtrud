# Static production contract for the separate linux/amd64 Beget host. This file
# is not runnable: copy it outside Git, replace every <placeholder>, chmod 0600,
# and validate it before rendering Compose. Endpoint, region and credentials
# must come from the created Beget S3 resource; they are never guessed.

COMPOSE_FILE=docker-compose.yml:docker-compose.production.yml
XTRUD_TARGET_ARCH=amd64

# Every runtime image is immutable and matches image-digests.json amd64.
XTRUD_IMAGE_STUDIO=supabase/studio:2026.08.03-sha-022b374@sha256:2616bb9ed337963fe27ce682b1783875083537d5fb54bfea4c399fb0c56ff03e
XTRUD_IMAGE_API_GW=envoyproxy/envoy:v1.39.0@sha256:f6e2f57b1bef8235083a2553b523508cf97d8991c893fd2aae3a94a6b21096a2
XTRUD_IMAGE_AUTH=supabase/gotrue:v2.189.0@sha256:0a8557cbe0fd53a067726fe656f79eb1b03a1ab3cdde4b59907ce5a1e1a202ab
XTRUD_IMAGE_REST=postgrest/postgrest:v14.12@sha256:560895fc1f6cb78f36ae64682c85bfc923c73da2d3a473ae2f55755fd7991ad1
XTRUD_IMAGE_REALTIME=supabase/realtime:v2.102.3@sha256:2cc87edf0db5cebf1f58c9a4116bb80a25ff764c8706b6802fa68d976e66e5d7
XTRUD_IMAGE_STORAGE=supabase/storage-api:v1.60.4@sha256:6f706c1184d97b081446527bb62a3193d3d47ad0daafcf738fd5c3e5a62aed97
XTRUD_IMAGE_IMGPROXY=darthsim/imgproxy:v3.30.1@sha256:965c3782818766a477a056016e18f88f9a028bf68b39cb2316978945ac2c0492
XTRUD_IMAGE_META=supabase/postgres-meta:v0.96.6@sha256:b9edad6fff2d4fb991ecd57837dbe3f21d2efa0f0ccb186f6ccf0e2d57192fed
XTRUD_IMAGE_FUNCTIONS=supabase/edge-runtime:v1.74.0@sha256:8c17262ecf2fcc43fe19c48d239280592129f2164e61f0f17ba56533120f92d5
XTRUD_IMAGE_DB=supabase/postgres:17.6.1.136@sha256:5a4314708484bec672de2c09653a5c01fb1c84a998564ac231b0325e2238ed5b
XTRUD_IMAGE_SUPAVISOR=supabase/supavisor:2.9.5@sha256:4dd940610c0ef5c8284ef88a28530566d45b52f7d3de285497a67c169e00cec9

# Stable public client interface. Caddy is the only public listener and proxies
# api.xtrud.pro to Envoy on 127.0.0.1:8000.
SUPABASE_PUBLIC_URL=https://api.xtrud.pro
API_EXTERNAL_URL=https://api.xtrud.pro/auth/v1
SITE_URL=https://xtrud.pro
ADDITIONAL_REDIRECT_URLS=https://xtrud.pro/reset-password,xtrud://reset-password
PROXY_DOMAIN=api.xtrud.pro
CERTBOT_EMAIL=<verified-operator-email>
API_GW_HTTP_PORT=127.0.0.1:8000
KONG_HTTP_PORT=8000
KONG_HTTPS_PORT=8443

# Generate fresh production-only values with the exact upstream utilities.
# Never reuse Supabase Cloud, rehearsal or Beget S3 credentials here.
POSTGRES_PASSWORD=<generate-production-only>
JWT_SECRET=<generate-production-only>
ANON_KEY=<derive-from-production-jwt-secret>
SERVICE_ROLE_KEY=<derive-from-production-jwt-secret>
SUPABASE_PUBLISHABLE_KEY=<generate-production-only>
SUPABASE_SECRET_KEY=<generate-production-only>
JWT_KEYS=<generate-production-only>
JWT_JWKS=<generate-production-only>
DASHBOARD_USERNAME=<generate-production-admin-username>
DASHBOARD_PASSWORD=<generate-production-only>
SECRET_KEY_BASE=<generate-production-only>
REALTIME_DB_ENC_KEY=<generate-exactly-16-characters>
VAULT_ENC_KEY=<generate-exactly-32-characters>
PG_META_CRYPTO_KEY=<generate-at-least-32-characters>
LOGFLARE_PUBLIC_ACCESS_TOKEN=<generate-at-least-32-characters>
LOGFLARE_PRIVATE_ACCESS_TOKEN=<generate-at-least-32-characters>
S3_PROTOCOL_ACCESS_KEY_ID=<generate-production-s3-api-key>
S3_PROTOCOL_ACCESS_KEY_SECRET=<generate-production-s3-api-secret>
ANON_KEY_ASYMMETRIC=<derive-with-upstream-utilities>
SERVICE_ROLE_KEY_ASYMMETRIC=<derive-with-upstream-utilities>

# Database and Supavisor. The overlay publishes neither database nor pooler.
POSTGRES_HOST=db
POSTGRES_DB=postgres
POSTGRES_PORT=5432
POOLER_PROXY_PORT_TRANSACTION=6543
POOLER_DEFAULT_POOL_SIZE=20
POOLER_MAX_CLIENT_CONN=100
POOLER_TENANT_ID=xtrud-production
POOLER_DB_POOL_SIZE=5

# Studio has no host port.
STUDIO_DEFAULT_ORGANIZATION=xtrud
STUDIO_DEFAULT_PROJECT=xtrud-production
OPENAI_API_KEY=

# Auth. Anonymous users are disabled; app registration remains explicit.
JWT_EXPIRY=3600
DISABLE_SIGNUP=false
MAILER_URLPATHS_CONFIRMATION=/auth/v1/verify
MAILER_URLPATHS_INVITE=/auth/v1/verify
MAILER_URLPATHS_RECOVERY=/auth/v1/verify
MAILER_URLPATHS_EMAIL_CHANGE=/auth/v1/verify
ENABLE_EMAIL_SIGNUP=true
ENABLE_EMAIL_AUTOCONFIRM=false
ENABLE_ANONYMOUS_USERS=false
ENABLE_PHONE_SIGNUP=false
ENABLE_PHONE_AUTOCONFIRM=false
SMTP_ADMIN_EMAIL=<verified-operator-email>
SMTP_HOST=<verified-production-smtp-host>
SMTP_PORT=587
SMTP_USER=<verified-production-smtp-user>
SMTP_PASS=<verified-production-smtp-secret>
SMTP_SENDER_NAME=xtrud

# External Beget S3 application-data bucket. The S3 API protocol credentials
# above must be different from these provider credentials.
STORAGE_BACKEND=s3
GLOBAL_S3_BUCKET=<verified-beget-application-bucket>
GLOBAL_S3_ENDPOINT=<verified-absolute-https-beget-s3-endpoint-url>
GLOBAL_S3_PROTOCOL=https
GLOBAL_S3_FORCE_PATH_STYLE=true
AWS_ACCESS_KEY_ID=<verified-beget-application-access-key>
AWS_SECRET_ACCESS_KEY=<verified-beget-application-secret-key>
REGION=<verified-beget-s3-region>
MINIO_ROOT_USER=<unused-upstream-required-value>
MINIO_ROOT_PASSWORD=<unused-upstream-required-value>
STORAGE_TENANT_ID=xtrud-production

# Functions/API/logging.
FUNCTIONS_VERIFY_JWT=false
PGRST_DB_SCHEMAS=public,storage,graphql_public
PGRST_DB_MAX_ROWS=1000
PGRST_DB_EXTRA_SEARCH_PATH=public,extensions
DOCKER_SOCKET_LOCATION=/var/run/docker.sock
GOOGLE_PROJECT_ID=
GOOGLE_PROJECT_NUMBER=
IMGPROXY_AUTO_WEBP=true
