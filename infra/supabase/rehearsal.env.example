# Static rehearsal contract for the arm64 developer machine. This file is not
# runnable as-is: copy it outside Git, replace every <placeholder>, chmod 0600,
# and keep the base/overlay pair in this exact order. For linux/amd64, replace
# all XTRUD_IMAGE_* values with the amd64 entries from image-digests.json and set
# XTRUD_TARGET_ARCH=amd64. Never mix architectures in one env file.

COMPOSE_FILE=docker-compose.yml:docker-compose.rehearsal.yml
XTRUD_TARGET_ARCH=arm64
XTRUD_REHEARSAL_API_PORT=18000

# Every runtime image is immutable and matches image-digests.json arm64.
XTRUD_IMAGE_STUDIO=supabase/studio:2026.08.03-sha-022b374@sha256:cb20b9a2b8fbb4f47a616c959dfdbde75668603c38d5ddd018e3f25a9f009937
XTRUD_IMAGE_API_GW=envoyproxy/envoy:v1.39.0@sha256:5edd669228659835ac243e3ffa5c08a65e92bb267d56da5c28317dbcf5a70292
XTRUD_IMAGE_AUTH=supabase/gotrue:v2.189.0@sha256:cce6c1d00352f22ee7634066012830f69636c157017ea166634c48dbb58eefb7
XTRUD_IMAGE_REST=postgrest/postgrest:v14.12@sha256:844785450d6b046ee97f1c67ea37e3ff6b4ed7ee3570b1b91c03f66f032c4805
XTRUD_IMAGE_REALTIME=supabase/realtime:v2.102.3@sha256:11651eb260639365adfd8d886ac1bfba9b069440cf92cc29f400f3b4a6554cb9
XTRUD_IMAGE_STORAGE=supabase/storage-api:v1.60.4@sha256:9326eb9c6b74c0a5ba393ab46a08a51d16bc5ea5f2978fc5b0f17fc67c64a4de
XTRUD_IMAGE_IMGPROXY=darthsim/imgproxy:v3.30.1@sha256:74215045236d40d5ee31868aeb72ee7940ae1f38a81ad8f8e6f7e53acb5b563c
XTRUD_IMAGE_META=supabase/postgres-meta:v0.96.6@sha256:abbb468e4e5a14b5b4edd29caf1fa1d98ee606da89fed3bfc653a6f85985401a
XTRUD_IMAGE_FUNCTIONS=supabase/edge-runtime:v1.74.0@sha256:ac5a8314e0c45b0f65d091643c1d6f5293e3a38f31fd3d15186e04a9d5c91cb7
XTRUD_IMAGE_DB=supabase/postgres:17.6.1.136@sha256:a9946f08d31e8eb1149229c94e5c26603a9233116807cbbd93d75179cbac516a
XTRUD_IMAGE_SUPAVISOR=supabase/supavisor:2.9.5@sha256:1dd306835b0215909cf76371a7a20be71268bbc97619f7133b882c5e9a7392e8

# Rehearsal-only URLs. .test is reserved for testing and Envoy is reachable
# only through 127.0.0.1:18000 on the host.
SUPABASE_PUBLIC_URL=http://127.0.0.1:18000
API_EXTERNAL_URL=http://127.0.0.1:18000/auth/v1
SITE_URL=https://app.xtrud.test
ADDITIONAL_REDIRECT_URLS=https://app.xtrud.test/reset-password,xtrud-rehearsal://reset-password
PROXY_DOMAIN=api.xtrud.test
CERTBOT_EMAIL=<not-used-in-rehearsal>
API_GW_HTTP_PORT=127.0.0.1:18000
KONG_HTTP_PORT=8000
KONG_HTTPS_PORT=8443

# Secrets. Generate fresh rehearsal-only values with the exact upstream
# utilities. Never reuse Supabase Cloud or future production credentials.
POSTGRES_PASSWORD=<generate-rehearsal-only>
JWT_SECRET=<generate-rehearsal-only>
ANON_KEY=<derive-from-rehearsal-jwt-secret>
SERVICE_ROLE_KEY=<derive-from-rehearsal-jwt-secret>
SUPABASE_PUBLISHABLE_KEY=<generate-rehearsal-only>
SUPABASE_SECRET_KEY=<generate-rehearsal-only>
JWT_KEYS=<generate-rehearsal-only>
JWT_JWKS=<generate-rehearsal-only>
DASHBOARD_USERNAME=<generate-rehearsal-admin-username>
DASHBOARD_PASSWORD=<generate-rehearsal-only>
SECRET_KEY_BASE=<generate-rehearsal-only>
REALTIME_DB_ENC_KEY=<generate-exactly-16-characters>
VAULT_ENC_KEY=<generate-exactly-32-characters>
PG_META_CRYPTO_KEY=<generate-at-least-32-characters>
LOGFLARE_PUBLIC_ACCESS_TOKEN=<generate-at-least-32-characters>
LOGFLARE_PRIVATE_ACCESS_TOKEN=<generate-at-least-32-characters>
S3_PROTOCOL_ACCESS_KEY_ID=<generate-rehearsal-only>
S3_PROTOCOL_ACCESS_KEY_SECRET=<generate-rehearsal-only>
ANON_KEY_ASYMMETRIC=<derive-with-upstream-utilities>
SERVICE_ROLE_KEY_ASYMMETRIC=<derive-with-upstream-utilities>

# Database and Supavisor. The overlay removes every Supavisor host port; these
# values remain internal container ports and pool settings only.
POSTGRES_HOST=db
POSTGRES_DB=postgres
POSTGRES_PORT=5432
POOLER_PROXY_PORT_TRANSACTION=6543
POOLER_DEFAULT_POOL_SIZE=20
POOLER_MAX_CLIENT_CONN=100
POOLER_TENANT_ID=xtrud-rehearsal
POOLER_DB_POOL_SIZE=5

# Studio remains private because it has no host port.
STUDIO_DEFAULT_ORGANIZATION=xtrud-rehearsal
STUDIO_DEFAULT_PROJECT=xtrud-rehearsal
OPENAI_API_KEY=

# Auth.
JWT_EXPIRY=3600
DISABLE_SIGNUP=false
MAILER_URLPATHS_CONFIRMATION=/auth/v1/verify
MAILER_URLPATHS_INVITE=/auth/v1/verify
MAILER_URLPATHS_RECOVERY=/auth/v1/verify
MAILER_URLPATHS_EMAIL_CHANGE=/auth/v1/verify
ENABLE_EMAIL_SIGNUP=true
ENABLE_EMAIL_AUTOCONFIRM=false
ENABLE_ANONYMOUS_USERS=false
ENABLE_PHONE_SIGNUP=false
ENABLE_PHONE_AUTOCONFIRM=false
SMTP_ADMIN_EMAIL=<rehearsal-operator-at-example.test>
SMTP_HOST=<rehearsal-smtp-host>
SMTP_PORT=587
SMTP_USER=<rehearsal-smtp-user>
SMTP_PASS=<rehearsal-smtp-secret>
SMTP_SENDER_NAME=xtrud-rehearsal

# File-backed Storage for the first isolated exact-stack rehearsal. External
# Beget S3 is a later separately reviewed overlay and credential contract.
GLOBAL_S3_BUCKET=xtrud-rehearsal-storage
REGION=local
MINIO_ROOT_USER=<unused-by-file-storage>
MINIO_ROOT_PASSWORD=<unused-by-file-storage>
STORAGE_TENANT_ID=xtrud-rehearsal

# Functions/API/logging.
# Current xtrud functions perform route-specific authorization themselves and
# must remain callable for reset/SMS/webhook flows. Runtime QA must prove each
# function rejects unauthorized requests according to its own contract.
FUNCTIONS_VERIFY_JWT=false
PGRST_DB_SCHEMAS=public,storage,graphql_public
PGRST_DB_MAX_ROWS=1000
PGRST_DB_EXTRA_SEARCH_PATH=public,extensions
DOCKER_SOCKET_LOCATION=/var/run/docker.sock
GOOGLE_PROJECT_ID=
GOOGLE_PROJECT_NUMBER=
IMGPROXY_AUTO_WEBP=true
