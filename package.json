{
  "name": "xtrud",
  "version": "1.0.1",
  "main": "expo-router/entry",
  "private": true,
  "packageManager": "npm@10.9.4",
  "engines": {
    "node": "20.19.x"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "check": "biome check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "tokens": "node scripts/generate-css-tokens.mjs",
    "tokens:check": "node scripts/generate-css-tokens.mjs --check",
    "governance:check": "node scripts/governance/check-agent-config.mjs",
    "security:audit": "node scripts/security/check-npm-audit.mjs",
    "security:audit:test": "node --test scripts/security/check-npm-audit.test.mjs",
    "release:version:test": "node --test scripts/release/version-utils.test.mjs",
    "release:contract:check": "node scripts/release/check-production-contract.mjs",
    "release:contract:test": "node --test scripts/release/check-production-contract.test.mjs",
    "release:legal:check": "node scripts/release/check-public-legal-pages.mjs",
    "release:legal:test": "node --test scripts/release/check-public-legal-pages.test.mjs",
    "supabase:integrity": "node scripts/supabase/check-migration-integrity.mjs",
    "supabase:integrity:test": "node --test scripts/supabase/check-migration-integrity.test.mjs",
    "supabase:backup-safety:test": "node --test scripts/supabase/backup-safety.test.mjs",
    "supabase:rehearsal-contract:test": "node --test scripts/supabase/rehearsal-contract.test.mjs",
    "supabase:backup:verify": "scripts/supabase/verify-encrypted-cloud-backup.sh",
    "supabase:universal:draft:test": "node --test scripts/supabase/universal-migration-fixture.test.mjs",
    "quality:check": "npm run governance:check && npm run supabase:integrity && npm run supabase:integrity:test && npm run supabase:backup-safety:test && npm run supabase:rehearsal-contract:test && npm run supabase:universal:draft:test && npm run security:audit:test && npm run release:contract:check && npm run release:contract:test && npm run release:legal:check && npm run release:legal:test && npm run release:version:test && npm run typecheck && npm run tokens:check && npx biome ci . && npm test && node scripts/release/check-version-consistency.mjs && node scripts/release/check-static-assets.mjs",
    "release:check": "npm run quality:check && npm run security:audit && npm run web:build:production",
    "store:check:ios": "node scripts/release/check-version-consistency.mjs --store-release ios",
    "store:check:android": "node scripts/release/check-version-consistency.mjs --store-release android",
    "web:build": "WEB_BUILD_MODE=preview node scripts/build-web-local.mjs",
    "web:build:preview": "WEB_BUILD_MODE=preview node scripts/build-web-local.mjs",
    "web:build:production": "WEB_BUILD_MODE=production node scripts/build-web-local.mjs",
    "web:serve": "npx serve dist -p 8082 -s",
    "web:dev": "node scripts/dev-web-local.mjs"
  },
  "dependencies": {
    "@expo-google-fonts/inter": "^0.4.1",
    "@hookform/resolvers": "^5.2.2",
    "@lottiefiles/dotlottie-react": "^0.19.2",
    "@react-navigation/bottom-tabs": "^7.4.0",
    "@react-navigation/elements": "^2.6.3",
    "@react-navigation/native": "^7.1.8",
    "@sentry/react-native": "~7.2.0",
    "@shopify/flash-list": "2.0.2",
    "@supabase/ssr": "^0.7.0",
    "@supabase/supabase-js": "^2.105.0",
    "@tanstack/react-query": "^5.62.0",
    "cal-sans": "^1.0.1",
    "expo": "~54.0.37",
    "expo-constants": "~18.0.13",
    "expo-device": "~8.0.10",
    "expo-font": "~14.0.11",
    "expo-image": "~3.0.11",
    "expo-image-manipulator": "~14.0.0",
    "expo-image-picker": "~17.0.11",
    "expo-linear-gradient": "~15.0.8",
    "expo-linking": "~8.0.11",
    "expo-localization": "~17.0.9",
    "expo-router": "~6.0.24",
    "expo-secure-store": "~15.0.0",
    "expo-splash-screen": "~31.0.13",
    "expo-status-bar": "~3.0.9",
    "expo-system-ui": "~6.0.9",
    "expo-updates": "~29.0.20",
    "lottie-react-native": "~7.3.1",
    "lucide-react-native": "^1.14.0",
    "nativewind": "^4.2.1",
    "phosphor-react-native": "^3.0.6",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-hook-form": "^7.54.0",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-url-polyfill": "^3.0.0",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.5.1",
    "tailwindcss": "^3.4.17",
    "zod": "^3.24.1",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@babel/core": "^7.25.0",
    "@biomejs/biome": "2.5.10",
    "@expo/env": "2.0.12",
    "@types/react": "~19.1.0",
    "@types/react-dom": "~19.1.0",
    "react-native-svg-transformer": "^1.5.3",
    "typescript": "~5.9.2",
    "vitest": "^4.1.6"
  }
}
