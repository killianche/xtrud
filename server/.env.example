# Переменные сервера xtrud-api. Настоящий файл — /opt/xtrud/xtrud-api.env на
# сервере (права 0600), в Git не попадает. Проверка и значения по умолчанию —
# server/src/config.ts: неполная настройка APNs или S3 не даёт серверу стартовать.

PORT=8100
# PostgreSQL (роль API; внутренняя сеть docker supabase_default).
DATABASE_URL=postgres://USER:PASSWORD@supabase-db:5432/postgres
# Тот же секрет, что у GoTrue, — не короче 32 символов.
JWT_SECRET=
JWT_ISSUER=xtrud-api
ACCESS_TTL_SECONDS=3600
REFRESH_TTL_DAYS=60
PHONE_EMAIL_DOMAIN=phone.xtrud.pro
POSTGREST_URL=http://supabase-rest:3000
FILES_ROOT=/data/files
FILES_PUBLIC_BASE=https://api.xtrud.pro/files

# Push напрямую в APNs. Либо все три, либо ни одного; с ними обязателен NOTIFY_SECRET.
APNS_KEY_PATH=
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_TOPIC=com.xtrud.app
# Общий секрет вызова /v2/internal/push из базы (vault.notify_secret).
NOTIFY_SECRET=

# Объектное хранилище Beget S3. Либо все пять, либо ни одного.
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
