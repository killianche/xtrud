{
  "name": "xtrud-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "xtrud API — свой сервер вместо Supabase (Beget). См. docs/BACKEND_REWRITE_PLAN.md",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "check": "npm run typecheck && npm test"
  },
  "dependencies": {
    "@fastify/cors": "^11.0.1",
    "@fastify/rate-limit": "^10.3.0",
    "bcryptjs": "^3.0.2",
    "fastify": "^5.3.2",
    "jose": "^6.0.11",
    "pg": "^8.16.0",
    "zod": "^3.24.4"
  },
  "devDependencies": {
    "@types/node": "^22.15.3",
    "@types/pg": "^8.15.2",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "vitest": "^3.1.3"
  }
}
